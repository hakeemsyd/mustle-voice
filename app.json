{
  "expo": {
    "name": "Mustle",
    "slug": "mustle-voice",
    "version": "1.0.0",
    "scheme": "mustle",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mustle.voice",
      "buildNumber": "3",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Mustle needs microphone access to hear your voice coaching requests.",
        "NSPhotoLibraryUsageDescription": "Mustle uses your photo library to let you show your coach a photo — of a meal, your form, or your progress."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "package": "com.mustle.voice"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-font",
      "./plugins/withSwiftUICoreLinkFix",
      "expo-audio",
      "expo-asset",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.421703647517-95geinli07j49llb1lts4ms4prc06e4v"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mustle uses your camera to let you show your coach a photo — of a meal, your form, or your progress.",
          "photosPermission": "Mustle uses your photo library to let you show your coach a photo — of a meal, your form, or your progress."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Mustle reads your weight, workouts, sleep and activity from Health so your coach can adjust your plan and recovery guidance — nothing is shared without your permission.",
          "NSHealthUpdateUsageDescription": "Mustle does not currently save any data back to Health.",
          "background": false
        }
      ]
    ]
  }
}
